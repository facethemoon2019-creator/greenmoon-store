{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "greenmoon-plants",
  "main": "./index.js",
  "compatibility_date": "2026-08-19",

  "ai": {
    "binding": "AI"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
